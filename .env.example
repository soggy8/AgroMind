# Copy to .env (repo root). Backend settings are read by backend/app/core/config.py.

# Backend
# Leave DATABASE_URL unset to use SQLite at backend/var/agromind.db (no setup).
# For PostgreSQL: `docker compose up -d db`, then uncomment:
# DATABASE_URL=postgresql://agromind:agromind@localhost:5432/agromind
AGROMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# AI assistant and advisor. Without a key, assistant chat returns a clear error; modules still work.
# Free key, no card: https://console.groq.com/keys (gsk_...). The provider is guessed
# from the key (gsk_ Groq, AIza Gemini, sk-or- OpenRouter, sk-ant- Anthropic); LLM_PROVIDER overrides.
LLM_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=              # default per provider; Groq: openai/gpt-oss-120b
# LLM_BASE_URL=           # any OpenAI-compatible API
# LLM_SPARE_MODEL=        # used when the main model's free quota runs out; Groq default: openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low  # leave empty for models that don't take it

# Frontend
VITE_API_URL=http://localhost:8000
